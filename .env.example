# ---------------------------------------------------------------------------------------------
# Sfumato Autonomous SOC — configuration
# start.sh / start.ps1 copy this file to .env on first run and generate the secrets marked (auto).
# Everything works without any external credential in REPRODUCIBLE DEMO mode.
# ---------------------------------------------------------------------------------------------

# --- Security (auto) ---------------------------------------------------------------------------
# Comma-separated API keys accepted in the X-API-Key header (the first one is used by the dashboard)
API_KEYS=sfumato-dev-key-change-me
# Used to encrypt credentials entered on the setup screen
SECRET_KEY=change-this-secret-key-for-credential-encryption
POSTGRES_PASSWORD=sfumato-db-password

# --- Modes ----------------------------------------------------------------------------------------
# demo = reproducible demo with labelled local CTI fixtures (offline) | live = real CTI providers
CTI_MODE=demo
# lite (default) or full (set automatically by docker-compose.full.yml)
DEPLOYMENT_MODE=lite
SEED_DEMO_INCIDENTS=true

# --- Threat intelligence (optional, read-only lookups) ---------------------------------------------
# Free key from https://auth.abuse.ch/ — enables ThreatFox + URLhaus
ABUSECH_AUTH_KEY=
# Free account at https://otx.alienvault.com/ → API key
OTX_API_KEY=
# Any reachable OpenCTI (FULL mode sets these automatically)
OPENCTI_URL=
OPENCTI_TOKEN=
# CISA KEV needs no key.

# --- AI investigator ----------------------------------------------------------------------------
# auto | ollama | anthropic | openai | deterministic
AI_PROVIDER=auto
# Ollama on the host (default) — or http://ollama:11434 with `docker compose --profile llm`
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# External LLMs receive pseudonymised data only, and only if explicitly allowed (or AI_PROVIDER is set to them)
AI_ALLOW_EXTERNAL=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Free option: Gemini through its OpenAI-compatible endpoint (no code change). Create the key in a project WITHOUT billing.
# On the free tier Google may use prompts to improve its products: use it for demo/synthetic incidents only.
# AI_PROVIDER=openai
# AI_ALLOW_EXTERNAL=true
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-3.5-flash-lite


# --- Cloud bucket: models + knowledge base built on Kaggle (see ml/guide/README.md) ---------------------------
# Reference triage model trained on Microsoft GUIDE, published by ml/guide/train_guide.py.
# Examples: gs://my-bucket/sfumato  |  hf://user/repo  |  a local folder
ML_ARTIFACT_URI=
# Knowledge base (RAG) for the AI investigator; the same bucket can hold both artifacts.
KB_ARTIFACT_URI=
# Alternative for the knowledge base: a private Hugging Face dataset repo.
KB_HF_REPO=
# Hugging Face read token (gated dataset / private repo).
HF_TOKEN=
# Shared secret that signs published artifacts. Models are pickles: unsigned remote ones are refused (auto-generated).
ARTIFACT_SIGNING_KEY=
# Path (inside the container) of a READ-ONLY service-account key placed in ./secrets, e.g. /run/secrets/gcs-reader.json
GOOGLE_APPLICATION_CREDENTIALS=

# --- FULL mode only (OpenCTI) — generated by `start.sh --full` / `start.ps1 -Full` (auto) ---------
OPENCTI_VERSION=6.9.9
OPENCTI_ADMIN_EMAIL=admin@sfumato.local
OPENCTI_ADMIN_PASSWORD=
OPENCTI_ADMIN_TOKEN=
OPENCTI_ENCRYPTION_KEY=
OPENCTI_HEALTH_KEY=
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=
CONNECTOR_MITRE_ID=
CONNECTOR_CISA_KEV_ID=
ELASTIC_MEMORY_SIZE=2G
